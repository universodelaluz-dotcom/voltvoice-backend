# Database
DATABASE_URL=postgresql://user:password@localhost:5432/voltvoice

# Mercado Pago
MERCADO_PAGO_ACCESS_TOKEN=APP_USR_YOUR_ACCESS_TOKEN_HERE
MERCADO_PAGO_PUBLIC_KEY=APP_USR_YOUR_PUBLIC_KEY_HERE

# Frontend URL
FRONTEND_URL=https://voltvoice.com

# Server
PORT=5000
NODE_ENV=production

# Google OAuth (login con Google)
GOOGLE_CLIENT_ID=your_google_client_id_here
# Opcional: varios IDs separados por coma (ej. local + prod)
GOOGLE_CLIENT_IDS=your_google_client_id_here,another_google_client_id_here

# ElevenLabs API
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# Inworld AI (opcional)
INWORLD_API_KEY=your_inworld_api_key

# Google reCAPTCHA (registro)
RECAPTCHA_SECRET=your_recaptcha_secret_key
RECAPTCHA_REQUIRED_IN_PROD=true
RECAPTCHA_REQUIRED_IN_DEV=false
